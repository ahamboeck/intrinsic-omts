# proto-file: intrinsic/skills/proto/skill_manifest.proto
# proto-message: intrinsic_proto.skills.SkillManifest
id {
  package: "ai.intrinsic"
  name: "suction_mesh_plan_grasp"
}
display_name: "Suction mesh plan grasp"
vendor {
  display_name: "OMTS"
}
documentation {
  description: "Plans a top-down suction grasp on a flat, level patch of a workpiece mesh and writes it to grasp and pregrasp frames. Simulation only: the cup model is not calibrated against hardware."
}
options {
  python_config {
    skill_module: "src.grasping.planners.suction_mesh.skill.suction_mesh_plan_grasp"
    proto_module: "src.grasping.planners.suction_mesh.skill.suction_mesh_plan_grasp_pb2"
    create_skill: "src.grasping.planners.suction_mesh.skill.suction_mesh_plan_grasp.SuctionMeshPlanGrasp"
  }
}
parameter {
  message_full_name: "omts.skills.SuctionMeshPlanGraspParams"
}
return_type {
  message_full_name: "omts.skills.SuctionMeshPlanGraspResult"
}
