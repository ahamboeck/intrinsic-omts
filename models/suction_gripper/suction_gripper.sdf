<?xml version="1.0" ?>
<!--
A single-cup vacuum gripper for simulation: a cylindrical body on the flange
and a 20 mm cup. Gazebo's EOAT suction plugin welds a part that touches the
`gripper_collision` link while the vacuum is on. The tool frame is at the
cup's sealing lip, so `gripper.model.suction.contact_depth_m` is 0.
-->
<sdf version="1.9" xmlns:intrinsic="https://intrinsic.ai/">
  <model name="suction_gripper">
    <link name="suction_body">
      <inertial>
        <mass>0.4</mass>
        <inertia>
          <ixx>0.0004</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0004</iyy>
          <iyz>0</iyz>
          <izz>0.0002</izz>
        </inertia>
      </inertial>
      <visual name="body_visual">
        <pose>0 0 0.05 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.03</radius>
            <length>0.1</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.35 1</ambient>
          <diffuse>0.3 0.3 0.35 1</diffuse>
        </material>
      </visual>
      <collision name="body_collision">
        <pose>0 0 0.05 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.03</radius>
            <length>0.1</length>
          </cylinder>
        </geometry>
      </collision>
    </link>
    <link name="gripper_collision">
      <pose>0 0 0.1 0 0 0</pose>
      <inertial>
        <mass>0.02</mass>
        <inertia>
          <ixx>0.000002</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000002</iyy>
          <iyz>0</iyz>
          <izz>0.000001</izz>
        </inertia>
      </inertial>
      <visual name="stem_visual">
        <pose>0 0 0.0075 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.006</radius>
            <length>0.015</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.6 0.6 0.6 1</ambient>
          <diffuse>0.6 0.6 0.6 1</diffuse>
        </material>
      </visual>
      <visual name="cup_visual">
        <pose>0 0 0.0225 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.01</radius>
            <length>0.015</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <!-- The cup, 20 mm wide, ends at the sealing lip 0.13 m from the flange. -->
      <collision name="cup_collision">
        <pose>0 0 0.015 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.01</radius>
            <length>0.03</length>
          </cylinder>
        </geometry>
      </collision>
    </link>
    <joint name="cup_joint" type="fixed">
      <parent>suction_body</parent>
      <child>gripper_collision</child>
    </joint>
    <frame name="tool_frame" attached_to="suction_body" intrinsic:create_entity="true">
      <pose>0 0 0.13 0 0 0</pose>
    </frame>
  </model>
</sdf>
